{
  "version": 1,
  "description": "GitHub Copilot lifecycle hooks for VS Code and CLI; install rewrites command cwd to the hydrated user hook directory.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node observe-user-intent.mjs",
            "cwd": "hooks",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node load-context.mjs",
            "cwd": "hooks",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node guard-critical-files.mjs",
            "cwd": "hooks",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "node block-destructive-commands.mjs",
            "cwd": "hooks",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "node require-plan-gate.mjs",
            "cwd": "hooks",
            "timeout": 40
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node record-successful-edit.mjs",
            "cwd": "hooks",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node preserve-context.mjs",
            "cwd": "hooks",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node require-verification.mjs",
            "cwd": "hooks",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
