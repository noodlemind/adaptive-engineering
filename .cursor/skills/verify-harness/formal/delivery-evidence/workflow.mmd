stateDiagram-v2
  %% Delivery-evidence workflow. Transition labels are the actions checked against rules.json.
  state "Answering a question" as AnswerMode
  state "Investigating" as InvestigateMode
  state "Reviewing" as ReviewMode
  state "Delivering, intent not yet locked" as Deliver
  state "Intent locked, changes in progress" as Locked
  state "Reviewed, proof not yet current" as Reviewed
  state "Verified, proof current" as Verified
  state "Learning recorded" as Compounded
  [*] --> AnswerMode
  [*] --> InvestigateMode
  [*] --> ReviewMode
  [*] --> Deliver : EnterDeliver
  AnswerMode --> Deliver : EnterDeliver
  InvestigateMode --> Deliver : EnterDeliver
  ReviewMode --> Deliver : EnterDeliver
  Deliver --> Locked : Lock
  Locked --> Locked : Edit
  Locked --> Locked : Amend
  Locked --> Reviewed : Review
  Reviewed --> Locked : Edit
  Reviewed --> Locked : Amend
  Reviewed --> Verified : Verify
  Verified --> Verified : Verify
  Verified --> Locked : Edit
  Verified --> Locked : Amend
  Verified --> Compounded : Compound
  AnswerMode --> AnswerMode : CaptureInsight
  InvestigateMode --> InvestigateMode : CaptureInsight
  ReviewMode --> ReviewMode : CaptureInsight
  Deliver --> Deliver : CaptureInsight
  Locked --> Locked : CaptureInsight
  Reviewed --> Reviewed : CaptureInsight
  Verified --> Verified : CaptureInsight
  Compounded --> [*]
